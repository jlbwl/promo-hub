# ===============================================
# 生产环境配置模板
# ===============================================

# ===============================================
# 通用环境设置
# ===============================================
NODE_ENV=production
TZ=Asia/Shanghai

# ===============================================
# API 服务配置
# ===============================================
API_PORT=3000
API_BASE_URL=https://www.jlbtg.cn/api

# ===============================================
# 数据库配置
# ===============================================
DB_HOST=${{ secrets.DB_HOST }}
DB_PORT=${{ secrets.DB_PORT }}
DB_USER=${{ secrets.DB_USER }}
DB_PASSWORD=${{ secrets.DB_PASSWORD }}
DB_NAME=${{ secrets.DB_NAME }}

# ===============================================
# Redis 缓存配置
# ===============================================
REDIS_HOST=${{ secrets.REDIS_HOST }}
REDIS_PORT=${{ secrets.REDIS_PORT }}
REDIS_PASSWORD=${{ secrets.REDIS_PASSWORD }}
REDIS_DB=0

# ===============================================
# Session 密钥（必须在 CI/CD Secrets 中配置强随机密钥）
# ===============================================
SESSION_SECRET=${{ secrets.SESSION_SECRET }}

# ===============================================
# 默认管理员账号（首次启动时自动创建）
# ===============================================
ADMIN_PHONE=${{ secrets.ADMIN_PHONE }}
ADMIN_PASSWORD=${{ secrets.ADMIN_PASSWORD }}
ADMIN_NAME=超级管理员

# ===============================================
# 阿里云短信配置
# ===============================================
ALIBABA_CLOUD_ACCESS_KEY_ID=${{ secrets.ALIBABA_CLOUD_ACCESS_KEY_ID }}
ALIBABA_CLOUD_ACCESS_KEY_SECRET=${{ secrets.ALIBABA_CLOUD_ACCESS_KEY_SECRET }}
ALIBABA_CLOUD_SMS_SIGN_NAME=${{ secrets.ALIBABA_CLOUD_SMS_SIGN_NAME }}
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=${{ secrets.ALIBABA_CLOUD_SMS_TEMPLATE_CODE }}

# ===============================================
# CORS 配置
# ===============================================
CORS_ORIGIN=https://www.jlbtg.cn,https://jlbtg.cn

# ===============================================
# 数据目录
# ===============================================
DATA_DIR=/var/data/promo-hub
