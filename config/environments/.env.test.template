# ===============================================
# 测试环境配置模板
# ===============================================

# ===============================================
# 通用环境设置
# ===============================================
NODE_ENV=test
TZ=Asia/Shanghai

# ===============================================
# API 服务配置
# ===============================================
API_PORT=3000
API_BASE_URL=https://test.promo-hub.example.com/api

# ===============================================
# 数据库配置
# ===============================================
DB_HOST=test-db.example.com
DB_PORT=3306
DB_USER=test_user
DB_PASSWORD=your_test_password
DB_NAME=promo_hub_test

# ===============================================
# Redis 缓存配置
# ===============================================
REDIS_HOST=test-redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=1

# ===============================================
# Session 密钥（必须在 CI/CD Secrets 中配置）
# ===============================================
SESSION_SECRET=${{ secrets.SESSION_SECRET }}

# ===============================================
# 默认管理员账号（测试环境专用）
# ===============================================
ADMIN_PHONE=${{ secrets.TEST_ADMIN_PHONE }}
ADMIN_PASSWORD=${{ secrets.TEST_ADMIN_PASSWORD }}
ADMIN_NAME=测试管理员

# ===============================================
# 阿里云短信配置
# ===============================================
ALIBABA_CLOUD_ACCESS_KEY_ID=${{ secrets.ALIBABA_CLOUD_ACCESS_KEY_ID }}
ALIBABA_CLOUD_ACCESS_KEY_SECRET=${{ secrets.ALIBABA_CLOUD_ACCESS_KEY_SECRET }}
ALIBABA_CLOUD_SMS_SIGN_NAME=${{ secrets.ALIBABA_CLOUD_SMS_SIGN_NAME }}
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=${{ secrets.ALIBABA_CLOUD_SMS_TEMPLATE_CODE }}

# ===============================================
# CORS 配置
# ===============================================
CORS_ORIGIN=https://test-admin.promo-hub.example.com,https://test-manager.promo-hub.example.com,https://test-user.promo-hub.example.com

# ===============================================
# 数据目录
# ===============================================
DATA_DIR=/var/data/promo-hub
