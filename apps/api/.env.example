# 数据库连接配置
DB_HOST=your_database_host.rds.aliyuncs.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=promo_hub

# 服务器配置
PORT=3000

# Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 密钥（如果使用 JWT）
# JWT_SECRET=your_jwt_secret_here

# 阿里云短信配置（可选）
# ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
# ALIBABA_CLOUD_SMS_SIGN_NAME=签名名称
# ALIBABA_CLOUD_SMS_TEMPLATE_CODE=SMS_xxxxxxxx

# 其他配置
# NODE_ENV=production
# DATA_DIR=/path/to/data/directory
