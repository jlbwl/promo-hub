# 数据库连接配置
DB_HOST=your_database_host.rds.aliyuncs.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=promo_hub

# 服务器配置
PORT=3000

# 鉴权密钥（必填：缺失时进程启动即失败；不足 32 字符会告警。生产环境务必使用强随机值）
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# 默认管理员账号配置（首次启动时创建）
ADMIN_PHONE=your_admin_phone
ADMIN_PASSWORD=your_admin_password
ADMIN_NAME=超级管理员

# Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 阿里云短信配置（可选）
# ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
# ALIBABA_CLOUD_SMS_SIGN_NAME=签名名称
# ALIBABA_CLOUD_SMS_TEMPLATE_CODE=SMS_xxxxxxxx

# CORS 允许的域名（多个用逗号分隔）
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# 其他配置
# NODE_ENV=production
# 上传文件根目录（图片实际落在 $DATA_DIR/uploads）。不配置时默认 apps/api/data，
# 仅适合本地开发；生产必须指向发布目录之外的持久目录，否则部署覆盖 api 目录会丢图。
# DATA_DIR=/path/to/data/directory

# 安全/业务时长（可选，未配置时使用默认值，行为与代码内写死值一致）
# ACCESS_TOKEN_TTL_SECONDS=3600            # Access Token 有效期，同时作为登出黑名单 TTL
# REFRESH_TOKEN_TTL_SECONDS=604800         # 普通角色 Refresh Token 有效期（默认 7 天）
# ADMIN_REFRESH_TOKEN_TTL_SECONDS=31536000 # 管理员 Refresh Token 滑动有效期（默认 365 天）
# REFRESH_TOKEN_GRACE_TTL_SECONDS=60       # Refresh Token 并发刷新宽限期
# CSRF_COOKIE_MAX_AGE_SECONDS=86400        # CSRF Cookie 有效期（默认 24 小时）
# OPERATION_LOG_EXPORT_MAX_ROWS=100000     # 操作日志单次导出上限

# 阿里云通用文字识别 OCR 密钥（可选，未配置则回退本地识别）
ALIYUN_OCR_ACCESS_KEY_ID=你的AccessKey_ID
ALIYUN_OCR_ACCESS_KEY_SECRET=你的AccessKey_Secret
# 可选：自定义接入点，留空使用 SDK 默认值
ALIYUN_OCR_ENDPOINT=
