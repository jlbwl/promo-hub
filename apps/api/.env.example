# 数据库连接配置
DB_HOST=your_database_host.rds.aliyuncs.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=promo_hub

# 服务器配置
PORT=3000

# Session 密钥（生产环境必须修改！）
SESSION_SECRET=change_this_to_a_secure_random_string_in_production

# 默认管理员账号配置（首次启动时创建）
ADMIN_PHONE=your_admin_phone
ADMIN_PASSWORD=your_admin_password
ADMIN_NAME=超级管理员

# Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 密钥（如果使用 JWT）
# JWT_SECRET=your_jwt_secret_here

# 阿里云短信配置（可选）
# ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
# ALIBABA_CLOUD_SMS_SIGN_NAME=签名名称
# ALIBABA_CLOUD_SMS_TEMPLATE_CODE=SMS_xxxxxxxx

# CORS 允许的域名（多个用逗号分隔）
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# 其他配置
# NODE_ENV=production
# DATA_DIR=/path/to/data/directory
