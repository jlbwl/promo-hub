{
  "name": "promo-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Self-promotion mini-program for business development",
  "scripts": {
    "dev:admin": "pnpm --filter @promo/admin dev",
    "dev:manager": "pnpm --filter @promo/manager dev",
    "dev:user": "pnpm --filter @promo/user dev",
    "build:admin": "pnpm --filter @promo/admin build",
    "build:manager": "pnpm --filter @promo/manager build",
    "build:user": "pnpm --filter @promo/user build",
    "build:api": "pnpm --filter @promo/api build",
    "build:shared": "pnpm --filter @promo/shared build",
    "lint": "eslint . --ext .vue,.js,.ts,.tsx",
    "type-check": "pnpm --filter @promo/admin exec vue-tsc --noEmit && pnpm --filter @promo/manager exec vue-tsc --noEmit && pnpm --filter @promo/user exec vue-tsc --noEmit && pnpm --filter @promo/shared exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.1.0"
  }
}
