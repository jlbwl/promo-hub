{
  "name": "promo-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Self-promotion mini-program for business development",
  "scripts": {
    "setup:env": "bash scripts/setup-env.sh",
    "setup:env:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-env.ps1",
    "dev:admin": "pnpm --filter @promo/admin dev",
    "dev:manager": "pnpm --filter @promo/manager dev",
    "dev:user": "pnpm --filter @promo/user dev",
    "dev:api": "pnpm --filter @promo/api dev",
    "dev": "concurrently \"pnpm dev:admin\" \"pnpm dev:manager\" \"pnpm dev:user\" \"pnpm dev:api\"",
    "build:admin": "pnpm --filter @promo/admin build",
    "build:manager": "pnpm --filter @promo/manager build",
    "build:user": "pnpm --filter @promo/user build",
    "build:api": "pnpm --filter @promo/api build",
    "build:shared": "pnpm --filter @promo/shared build",
    "build": "pnpm build:shared && pnpm build:admin && pnpm build:manager && pnpm build:user && pnpm build:api",
    "lint": "eslint . --ext .vue,.js,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.js,.ts,.tsx --fix",
    "type-check": "pnpm --filter @promo/admin exec vue-tsc --noEmit && pnpm --filter @promo/manager exec vue-tsc --noEmit && pnpm --filter @promo/user exec vue-tsc --noEmit && pnpm --filter @promo/shared exec tsc --noEmit && pnpm --filter @promo/api exec tsc --noEmit",
    "test": "pnpm build:shared && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "pre-commit": "pnpm lint && pnpm type-check && pnpm test"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ],
    "overrides": {
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "2.1.7",
      "nanoid@3": "3.3.19",
      "ip-address": "^10.7.2",
      "postcss": "^8.5.28",
      "cookie": "^0.7.0",
      "qs": "^6.15.2",
      "body-parser": "^1.20.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "globals": "^15.0.0",
    "happy-dom": "^20.9.0",
    "msw": "^2.14.5",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.1.0"
  }
}
